<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vault OS - Architecture Documentation</title>
    <!-- PrismJS for sleek syntax highlighting -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" />
    <style>
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; 
            background-color: #0f172a; /* Slate 900 */
            color: #f8fafc; 
            padding: 40px; 
            margin: 0; 
            line-height: 1.6;
        }
        .container { max-width: 900px; margin: 0 auto; }
        .header { text-align: center; margin-bottom: 50px; padding-bottom: 20px; border-bottom: 2px solid #1e293b; }
        h1 { color: #818cf8; margin-bottom: 10px; font-size: 2.5em; }
        .subtitle { color: #94a3b8; font-size: 1.1em; }
        
        .snippet-card { 
            background-color: #1e293b; 
            border-radius: 12px; 
            padding: 30px; 
            margin-bottom: 40px; 
            border: 1px solid #334155; 
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .snippet-card h3 { color: #c7d2fe; margin-top: 0; font-size: 1.4em; }
        .meta { display: flex; gap: 15px; margin-bottom: 20px; font-size: 0.9em; }
        .tag { background: #312e81; color: #e0e7ff; padding: 6px 12px; border-radius: 6px; font-weight: 500; }
        .tag.complexity { background: #064e3b; color: #34d399; font-family: monospace; }
        .vuln { background-color: rgba(239, 68, 68, 0.1); color: #fca5a5; padding: 12px; border-radius: 8px; border-left: 4px solid #ef4444; margin-bottom: 20px; }
        
        pre { border-radius: 8px !important; margin: 0 !important; border: 1px solid rgba(255,255,255,0.05); }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Vault OS</h1>
            <div class="subtitle">Auto-Generated Project Documentation & Architecture Manual</div>
        </div>
        
        <% if (snippets.length === 0) { %>
            <div class="snippet-card">
                <p style="text-align: center; color: #94a3b8;">No snippets found in this vault. Add some code to generate documentation!</p>
            </div>
        <% } else { %>
            <% snippets.forEach(function(snippet, index) { %>
                <div class="snippet-card">
                    <h3><%= index + 1 %>. <%= snippet.summary %></h3>
                    
                    <div class="meta">
                        <span class="tag"><%= snippet.language %></span>
                        <span class="tag complexity">⏱ <%= snippet.timeComplexity %></span>
                    </div>
                    
                    <% if (snippet.vulnerabilities && snippet.vulnerabilities.toLowerCase() !== 'none detected') { %>
                        <div class="vuln">
                            <strong>⚠️ Security Note:</strong> <%= snippet.vulnerabilities %>
                        </div>
                    <% } %>
                    
                    <pre><code class="language-<%= snippet.language.toLowerCase() %>"><%= snippet.rawCode %></code></pre>
                </div>
            <% }); %>
        <% } %>
    </div>

    <!-- PrismJS Scripts for formatting code blocks beautifully -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
</body>
</html>